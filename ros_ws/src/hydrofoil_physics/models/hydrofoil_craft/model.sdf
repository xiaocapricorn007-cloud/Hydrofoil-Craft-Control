<?xml version="1.0"?>
<!-- Reference hydrofoil craft.  Single rigid body; the link origin is the CG.
     Link frame is FLU (x forward, y left/port, z up).  Foil positions from
     thesis Table A.1 (FRD: fore foils x=+1.1, y=+-0.62, z=+0.75 below CG;
     aft foil x=-2.45, z=+0.96).  Izz is NOT from the source (it uses a
     placeholder of 1 with yaw locked); 503 (= Iyy) is an assumption.
     No collision geometry: nothing here touches anything (hull model = later). -->
<sdf version="1.11">
  <model name="hydrofoil_craft">
    <link name="hull">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>215</mass>
        <inertia><ixx>31</ixx><iyy>503</iyy><izz>503</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>

      <!-- Visuals: meshes generated by scripts/make_craft_visuals.py, in the link frame.
           Foils, struts and propeller follow thesis Table A.1; hull, deck, solar array
           and pilot are illustrative (the reference gives no above-water geometry).
           Visual only: no extra links, mass or collisions. -->
      <visual name="hull_bottom">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/hull_bottom.obj</uri></mesh></geometry>
        <material>
          <ambient>0.558 0.558 0.570 1</ambient><diffuse>0.930 0.930 0.950 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.3</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="hull_side">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/hull_side.obj</uri></mesh></geometry>
        <material>
          <ambient>0.570 0.570 0.582 1</ambient><diffuse>0.950 0.950 0.970 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.25</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="hull_stripe">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/hull_stripe.obj</uri></mesh></geometry>
        <material>
          <ambient>0.030 0.072 0.180 1</ambient><diffuse>0.050 0.120 0.300 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.3</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="transom">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/transom.obj</uri></mesh></geometry>
        <material>
          <ambient>0.558 0.558 0.570 1</ambient><diffuse>0.930 0.930 0.950 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.3</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="deck">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/deck.obj</uri></mesh></geometry>
        <material>
          <ambient>0.510 0.516 0.522 1</ambient><diffuse>0.850 0.860 0.870 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.75</roughness><metalness>0.0</metalness>
              <albedo_map>model://hydrofoil_craft/materials/textures/deck_nonskid.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="solar_cells">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/solar_cells.obj</uri></mesh></geometry>
        <material>
          <ambient>0.600 0.600 0.600 1</ambient><diffuse>1.000 1.000 1.000 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.12</roughness><metalness>0.15</metalness>
              <albedo_map>model://hydrofoil_craft/materials/textures/solar_cells.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="solar_frame">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/solar_frame.obj</uri></mesh></geometry>
        <material>
          <ambient>0.468 0.474 0.486 1</ambient><diffuse>0.780 0.790 0.810 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.35</roughness><metalness>0.9</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="struts">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/struts.obj</uri></mesh></geometry>
        <material>
          <ambient>0.060 0.060 0.066 1</ambient><diffuse>0.100 0.100 0.110 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.3</roughness><metalness>0.2</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="foils">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/foils.obj</uri></mesh></geometry>
        <material>
          <ambient>0.060 0.060 0.066 1</ambient><diffuse>0.100 0.100 0.110 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.3</roughness><metalness>0.2</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="pod">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/pod.obj</uri></mesh></geometry>
        <material>
          <ambient>0.072 0.072 0.078 1</ambient><diffuse>0.120 0.120 0.130 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.35</roughness><metalness>0.3</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="propeller">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/propeller.obj</uri></mesh></geometry>
        <material>
          <ambient>0.480 0.372 0.150 1</ambient><diffuse>0.800 0.620 0.250 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.25</roughness><metalness>1.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="seat">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/seat.obj</uri></mesh></geometry>
        <material>
          <ambient>0.090 0.090 0.096 1</ambient><diffuse>0.150 0.150 0.160 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.6</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="pilot_vest">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/pilot_vest.obj</uri></mesh></geometry>
        <material>
          <ambient>0.570 0.228 0.030 1</ambient><diffuse>0.950 0.380 0.050 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.7</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="pilot_skin">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/pilot_skin.obj</uri></mesh></geometry>
        <material>
          <ambient>0.480 0.360 0.288 1</ambient><diffuse>0.800 0.600 0.480 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.6</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="pilot_helmet">
        <geometry><mesh><uri>model://hydrofoil_craft/meshes/pilot_helmet.obj</uri></mesh></geometry>
        <material>
          <ambient>0.570 0.570 0.570 1</ambient><diffuse>0.950 0.950 0.950 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
              <roughness>0.25</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>

      <particle_emitter name="spray_fs" type="point">
        <!-- cosmetic: spray where the strut cuts the surface at the design ride height -->
        <pose>1.1 -0.62 -0.30 0 -2.3 0</pose>
        <emitting>true</emitting>
        <particle_size>0.06 0.06 0.06</particle_size>
        <lifetime>0.4</lifetime>
        <rate>220</rate>
        <min_velocity>0.6</min_velocity>
        <max_velocity>1.6</max_velocity>
        <scale_rate>0.25</scale_rate>
        <color_start>1 1 1 0.55</color_start>
        <color_end>1 1 1 0</color_end>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://hydrofoil_craft/materials/textures/spray.png</albedo_map></metal></pbr>
        </material>
      </particle_emitter>
      <particle_emitter name="spray_fp" type="point">
        <!-- cosmetic: spray where the strut cuts the surface at the design ride height -->
        <pose>1.1 0.62 -0.30 0 -2.3 0</pose>
        <emitting>true</emitting>
        <particle_size>0.06 0.06 0.06</particle_size>
        <lifetime>0.4</lifetime>
        <rate>220</rate>
        <min_velocity>0.6</min_velocity>
        <max_velocity>1.6</max_velocity>
        <scale_rate>0.25</scale_rate>
        <color_start>1 1 1 0.55</color_start>
        <color_end>1 1 1 0</color_end>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://hydrofoil_craft/materials/textures/spray.png</albedo_map></metal></pbr>
        </material>
      </particle_emitter>
      <particle_emitter name="spray_a" type="point">
        <!-- cosmetic: spray where the strut cuts the surface at the design ride height -->
        <pose>-2.45 0.0 -0.30 0 -2.3 0</pose>
        <emitting>true</emitting>
        <particle_size>0.06 0.06 0.06</particle_size>
        <lifetime>0.4</lifetime>
        <rate>220</rate>
        <min_velocity>0.6</min_velocity>
        <max_velocity>1.6</max_velocity>
        <scale_rate>0.25</scale_rate>
        <color_start>1 1 1 0.55</color_start>
        <color_end>1 1 1 0</color_end>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://hydrofoil_craft/materials/textures/spray.png</albedo_map></metal></pbr>
        </material>
      </particle_emitter>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/hydrofoil/imu</topic>
      </sensor>
      <sensor name="chase_cam" type="camera">
        <!-- behind, to port and above the craft, looking at it -->
        <pose>-8 4.5 3.0 0 0.316 -0.512</pose>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>/hydrofoil/camera</topic>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>960</width><height>540</height></image>
          <clip><near>0.1</near><far>500</far></clip>
        </camera>
      </sensor>
    </link>

    <plugin filename="FoilDynamics" name="hydrofoil::FoilDynamics">
      <link_name>hull</link_name>
      <rho>1024.8</rho>
      <wagner>true</wagner>
      <!-- plant fidelity: ref (validated reference model) | v2 (phase 4) | mask | names.
           The launch argument physics:= overrides this at run time. -->
      <physics>ref</physics>
      <actuator_tau>0.1</actuator_tau>
      <!-- water look (visual only) -->
      <water_color>0.02 0.16 0.26</water_color>
      <water_specular>0.6</water_specular>
      <wave_visual_half_x>32</wave_visual_half_x>
      <wave_visual_half_y>18</wave_visual_half_y>
      <initial_speed>7.0</initial_speed>
      <!-- trim at 7 m/s from hydrofoil/linearize.py: fore, fore, aft [rad]; rpm -->
      <initial_delta>0.05743 0.05743 0.05209</initial_delta>
      <initial_rpm>1170.4</initial_rpm>
      <lock_sway_yaw>true</lock_sway_yaw>
      <hold_until_command>true</hold_until_command>
      <state_rate>100</state_rate>
    </plugin>
  </model>
</sdf>
