<?xml version="1.0"?>
<!-- Phase 0 world: flat calm sea (visual only), 1 ms physics step.
     Gazebo world frame is ENU (z up); the hydrofoil model equations are NED
     (z down). The conversion is handled in the physics plugin (phase 1).
     'placeholder_hull' has the reference craft's mass and inertia
     (215 kg, Ixx 31, Iyy 503) and floats on a crude buoyancy-free stand-in:
     it is static for now, only there to check rendering and sensors. -->
<sdf version="1.11">
  <world name="ocean">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.35 0.37 0.42 1</ambient>
      <background>0.55 0.75 0.95 1</background>
      <grid>false</grid>
      <sky></sky>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.9 0.88 0.8 1</specular>
      <direction>-0.6 0.3 -0.4</direction>
    </light>

    <model name="sea_surface">
      <static>true</static>
      <pose>0 0 -1.5 0 0 0</pose>
      <link name="link">
        <visual name="water">
          <geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
          <!-- same look as the wave patch drawn by FoilDynamics (water_* params);
               markers use classic shading, so no <pbr> here either -->
          <material>
            <ambient>0.014 0.112 0.182 1</ambient>
            <diffuse>0.02 0.16 0.26 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="placeholder_hull">
      <static>true</static>
      <pose>0 0 0.3 0 0 0</pose>
      <link name="hull">
        <inertial>
          <mass>215</mass>
          <inertia><ixx>31</ixx><iyy>503</iyy><izz>503</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body">
          <geometry><box><size>6.0 1.6 0.25</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <sensor name="imu" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>imu</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
